import os
import json
from datetime import datetime
from collections import deque

def log():
    repo_path = ".minigit"

    if not os.path.isdir(repo_path):
        print("MiniGit repository not found.")
        return

    head_path = os.path.join(repo_path, "HEAD")

    with open(head_path, "r") as head_file:
        head_content = head_file.read().strip()

    if not head_content.startswith("ref: "):
        print("Invalid HEAD reference.")
        return

    branch_ref = head_content[5:]
    branch_path = os.path.join(repo_path, branch_ref)

    if not os.path.isfile(branch_path):
        print("No commits yet.")
        return

    with open(branch_path, "r") as branch_file:
        current_hash = branch_file.read().strip()

    if not current_hash:
        print("No commits yet.")
        return

    queue = deque([current_hash])

    visited = set()

    while queue:

        commit_hash = queue.popleft()

        if commit_hash in visited:
            continue

        visited.add(commit_hash)

        object_path = os.path.join(
            repo_path, "objects", commit_hash
        )

        if not os.path.isfile(object_path):
            print("Commit object not found:", commit_hash)
            continue

        with open(object_path, "r") as object_file:
            commit_data = json.load(object_file)

        commit_time = datetime.fromtimestamp(
            commit_data["timestamp"]
        )

        print("commit", commit_hash)
        print("Date:", commit_time)
        print()
        print("    " + commit_data["message"])

        second_parent = commit_data.get("second_parent")

        if second_parent:
            print("    Second parent:", second_parent)

        print()

        parent = commit_data.get("parent")

        if parent:
            queue.append(parent)

        if second_parent:
            queue.append(second_parent)


if __name__ == "__main__":
    log()
